parameters:
    level: 8
    ignoreErrors:
        -
            identifier: missingType.generics
        -
            identifier: missingType.iterableValue
        -
            identifier: trait.unused
    paths:
        - Spryker/
        - SprykerStrict/
        - GlueStreamSpecific/
    bootstrapFiles:
        - '%rootDir%/../../../tests/bootstrap.php'
